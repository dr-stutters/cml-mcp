# Copy to .env and fill in.

# CML API base URL — MUST include the /api/v0 prefix.
CML_MCP_BASE_URL=https://cml.example.com/api/v0

# CML credentials (JWT is acquired automatically via POST /authenticate).
CML_MCP_USERNAME=admin
CML_MCP_PASSWORD=changeme
# ...or supply a pre-acquired JWT instead (takes precedence):
# CML_MCP_API_TOKEN=

# CML almost always runs with a self-signed certificate:
CML_MCP_VERIFY_TLS=false

# Safety: write tools (create/start/stop/wipe/delete/captures) stay hidden
# until this is true.
CML_MCP_ENABLE_WRITES=false

# Tuning (defaults shown):
# CML_MCP_TIMEOUT_SECONDS=30
# CML_MCP_MAX_RETRIES=3
# CML_MCP_MAX_CONCURRENT_REQUESTS=5
# CML_MCP_MAX_RESPONSE_CHARS=40000
# CML_MCP_LOG_LEVEL=INFO
